# ============================================================
# LLM Provider (选哪个填哪个，未选的注释掉即可)
# ============================================================
LLM_PROVIDER=deepseek           # deepseek | openai | anthropic

# --- DeepSeek ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
# deepseek-v4-pro   → DeepSeek-V4 旗舰版 (1.6T/49B, 1M上下文)
# deepseek-v4-flash → DeepSeek-V4 轻量版 (284B/13B, 1M上下文)

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# --- Anthropic / Claude Code ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Anthropic 兼容网关（如火山方舟 ARK）---
# LLM_PROVIDER=anthropic
# ANTHROPIC_AUTH_TOKEN=your_local_token_here
# ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
# ANTHROPIC_MODEL=glm-5.3[1m]
API_TIMEOUT_MS=120000

# ============================================================
# Application Settings
# ============================================================
AGENT_TEMPERATURE=0.7
AGENT_MAX_ITERATIONS=10
DEBUG=false
LOG_LEVEL=INFO

# ============================================================
# Agent API 服务配置（暴露给前端同事的 HTTP 接口）
# ============================================================
API_HOST=0.0.0.0                # 监听地址，0.0.0.0 = 所有网卡
API_PORT=8000                   # 监听端口
API_CORS_ORIGINS=*              # CORS 允许的前端域名，逗号分隔。生产环境应改为实际指挥中心域名
API_KEY=                        # API 鉴权密钥。空 = 不启用（开发模式），填值后前端需带 Authorization: Bearer <key>
FRONTEND_BASE_URL=http://localhost:5173  # Streamlit 演示前端生成页面链接时使用的指挥中心地址

# ============================================================
# 交通数据源配置（默认使用 TrafficSim 确定性仿真）
# ============================================================
TRAFFIC_BACKEND=sim
# 接入真实指挥中心后端时改为 real，并配置 REST 根地址
TRAFFIC_API_BASE_URL=
# 固定演示时钟（可选，ISO8601）；留空使用本机当前时间
# TRAFFIC_SIM_CLOCK=2026-09-13T08:30:00
# RAG 向量后端：hashing=离线可用；bge=需要本地缓存或访问 Hugging Face
TRAFFIC_EMBEDDING_BACKEND=hashing

# ============================================================
# 记忆模块配置（L1 checkpoint + L2 长期记忆，共用 PostgreSQL）
# ============================================================
MEMORY_ENABLED=false
MEMORY_POSTGRES_DSN=postgresql://trafficgraph:trafficgraph@localhost:5432/trafficgraph
LANGGRAPH_STRICT_MSGPACK=true
CHECKPOINT_TABLE=checkpoints
STORE_TABLE=store
MEMORY_NAMESPACE_PREFIX=trafficgraph
MEMORY_ENV=dev
MEMORY_DEFAULT_AREA_ID=local
MEMORY_DEFAULT_AGENT_ID=main_graph
MEMORY_DEFAULT_TTL_SECONDS=0
MEMORY_AUTO_EXTRACT_ENABLED=false
MEMORY_EXTRACT_MIN_CONFIDENCE=0.65
MEMORY_MAX_MEMORIES_PER_TURN=3
MEMORY_DEVICE_STATE_DEFAULT_TTL_SECONDS=86400
MEMORY_USE_POSTGRES_STORE=false
# Demo only: L2 InMemory fallback 落盘到 data/long_term_memory_demo/memories.json，便于人工测试重启后复查
MEMORY_DEMO_FILE_STORE_ENABLED=false
MEMORY_DEMO_FILE_STORE_PATH=data/long_term_memory_demo/memories.json
